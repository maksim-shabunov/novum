# Keep the build context small. Without this, `docker build` would upload the
# ~3 GB of data/ before running a single instruction.
data/
runs/
.venv/
venv/
.git/
.github/
web/node_modules/
# A local `next build` leaves a standalone bundle that carries its own copy of
# node_modules -- and repeated builds accumulate several. Copying that into the
# image would upload hundreds of megabytes only for `npm run build` to
# regenerate it, so the container always builds from source.
web/.next/
web/out/

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

.env
*.part
*.tmp
.DS_Store

# artifacts/ is intentionally NOT ignored: the API image serves the committed
# weights, and docker-compose also mounts the directory read-only at runtime.
