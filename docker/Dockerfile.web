# =============================================================================
# NOVUM mission-control console.
#
#   docker compose -f docker/docker-compose.yml up
#
# Multi-stage: node builds, then a slim runtime serves the standalone output.
# The precomputed grid is COPIED IN, not generated here -- this image never
# sees the dataset, never loads a model, and never imports Python. That is the
# point of precomputing: the console is a static site with one small API beside
# it for the briefing prose.
# =============================================================================
FROM node:22-slim AS build

WORKDIR /app

# Dependencies first, so a source edit does not re-resolve the tree.
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./

# The console cannot start without its precomputed grid, and a build that
# silently produces an empty console is worse than one that stops.
RUN test -f public/data/grid.json || { \
      echo "ERROR: web/public/data/grid.json is missing." >&2; \
      echo "Run 'make console' on a machine with the dataset and commit it." >&2; \
      exit 1; \
    }

ENV NEXT_TELEMETRY_DISABLED=1

# WHERE THE BROWSER FINDS THE API IS A BUILD-TIME DECISION, not a runtime one.
# Next inlines every NEXT_PUBLIC_* value into the client bundle during `npm run
# build`, so setting this in compose's `environment:` would have done exactly
# nothing -- it would have worked by accident on a laptop, where the default is
# already right, and silently failed for anyone serving from a real hostname.
# Passed as a build arg it is genuinely configurable:
#     docker compose build --build-arg NEXT_PUBLIC_NOVUM_API=https://api.example.com
ARG NEXT_PUBLIC_NOVUM_API=http://127.0.0.1:8000
ENV NEXT_PUBLIC_NOVUM_API=${NEXT_PUBLIC_NOVUM_API}

RUN npm run build


FROM node:22-slim AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

# `output: "standalone"` in next.config.ts emits a self-contained server with
# only the modules actually reached, so the runtime image carries no toolchain.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

RUN useradd --system --uid 1001 novum && chown -R novum:novum /app
USER novum

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
