# ---------------------------------------------------------------------------
# NOVUM environment template.
#
# Copy to .env and edit.  .env is gitignored and must never be committed.
#     cp .env.example .env
#
# Everything below has a safe default baked into the code, so an empty .env
# still boots. Nothing here is required to run `make data` / `make train`.
# ---------------------------------------------------------------------------

# --- Paths -----------------------------------------------------------------
# Override if your data lives on a separate volume (common on rented boxes).
# NOVUM_DATA_DIR=/mnt/scratch/novum-data
# NOVUM_ARTIFACTS_DIR=./artifacts
# NOVUM_RUNS_DIR=./runs

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
NOVUM_LOG_LEVEL=INFO

# Force plain line-by-line progress output instead of a redrawing bar.
# Set to 1 for CI, nohup, or when piping a tmux session to a log file.
# NOVUM_PLAIN_PROGRESS=0

# --- Data fetch ------------------------------------------------------------
NOVUM_ZENODO_RECORD_ID=3732485
# Seconds before a stalled download is retried.
NOVUM_HTTP_TIMEOUT=60
NOVUM_HTTP_RETRIES=5

# --- API (serving) ---------------------------------------------------------
NOVUM_API_HOST=127.0.0.1
NOVUM_API_PORT=8000
# Comma-separated. Use explicit origins in production, never "*" with credentials.
NOVUM_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Artifact the API serves by default (relative to NOVUM_ARTIFACTS_DIR).
NOVUM_DEFAULT_ARTIFACT=rad750.npz

# --- Secrets ---------------------------------------------------------------
# Optional bearer token for the API. Leave blank to disable auth entirely.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
NOVUM_API_KEY=

# Only needed for Zenodo endpoints that require auth (the NOVUM dataset does not).
# ZENODO_TOKEN=
